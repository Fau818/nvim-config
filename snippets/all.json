{
  "# Weight 1 -- box (top level, heavy)": {
    "body": [
      "$LINE_COMMENT ════════════════════════════════════════════════════════════",
      "$LINE_COMMENT ══════════════════════════ ${1:Region} ══════════════════════════",
      "$LINE_COMMENT ════════════════════════════════════════════════════════════$0"
    ],
    "prefix": "sec1"
  },
  "# Weight 2 -- single line (top level, light)": {
    "body": "$LINE_COMMENT ══════════════════════════ ${1:Region} ══════════════════════════$0",
    "prefix": "sec2"
  },
  "# Weight 3 -- section": {
    "body": "$LINE_COMMENT ─── ${1:Section} ────────────────────────────────────────────────$0",
    "prefix": "sec3"
  },
  "# Weight 4 -- subsection": {
    "body": "$LINE_COMMENT ┄┄┄ ${1:Subsection}$0",
    "prefix": "sec4"
  }
}
